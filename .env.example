# DocRenew Configuration Example
# Copy this file to .env and supply your API key (if using Groq).
# If using offline mode, no key or network is required.

DOCRENEW_PROVIDER=offline
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
DOCRENEW_DB=docrenew.db
DOCRENEW_OUTPUT_DIR=outputs
